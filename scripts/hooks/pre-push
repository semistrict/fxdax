#!/usr/bin/env bash
# Copyright 2026 The fxdax Authors. All rights reserved.
# Use of this source code is governed by a BSD-style license that can be
# found in the LICENSE file.

# Refuses a push that changes the guest's DAX code (fs/fxfs, the extent device's driver) unless
# the commit pushed passed scripts/dax-gate.sh, which notes it (`git notes --ref=dax-gate`)
# (TASK-119.8). `git config core.hooksPath scripts/hooks` installs it.
set -euo pipefail

dax_paths=(guest/linux/fs/fxfs guest/linux/drivers/virtio_extent)
zero=0000000000000000000000000000000000000000
status=0
while read -r local_ref local_sha remote_ref remote_sha; do
    [[ $local_sha == "$zero" ]] && continue
    if [[ $remote_sha == "$zero" ]]; then
        base=$(git merge-base "$local_sha" origin/main 2>/dev/null || true)
    else
        base=$remote_sha
    fi
    range=${base:+$base..}$local_sha
    if [[ -z $(git diff --name-only "$range" -- "${dax_paths[@]}" 2>/dev/null) ]]; then
        continue
    fi
    if ! git notes --ref=dax-gate show "$local_sha" > /dev/null 2>&1; then
        echo "pre-push: $local_ref changes the guest's DAX code; ${local_sha:0:12} has not passed" \
            "scripts/dax-gate.sh (TASK-119.8)" >&2
        status=1
    fi
done
exit $status
