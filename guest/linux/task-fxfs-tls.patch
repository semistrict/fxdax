fxdax's patch to the guest kernel (scripts/build-guest-kernel.sh applies it): a slot in each task
for the thread-local values of fs/fxfs's Rust, which a new task starts without, and which are
dropped as the task exits (fs/fxfs/rt.c, include/linux/fxfs_tls.h).

diff -ru a/include/linux/sched.h b/include/linux/sched.h
--- a/include/linux/sched.h
+++ b/include/linux/sched.h
@@ -1241,6 +1241,9 @@
 	/* Journalling filesystem info: */
 	void				*journal_info;
 
+	/* fxdax: the thread-local values of fs/fxfs's Rust (fs/fxfs/rt.c). */
+	void				*fxfs_tls;
+
 	/* Stacked block device info: */
 	struct bio_list			*bio_list;
 
diff -ru a/kernel/exit.c b/kernel/exit.c
--- a/kernel/exit.c
+++ b/kernel/exit.c
@@ -79,6 +79,8 @@
 
 #include "exit.h"
 
+#include <linux/fxfs_tls.h>
+
 /*
  * The default value should be high enough to not crash a system that randomly
  * crashes its kernel from time to time, but low enough to at least not permit
@@ -954,6 +956,7 @@
 	exit_shm(tsk);
 	exit_files(tsk);
 	exit_fs(tsk);
+	fxfs_rt_tls_exit(tsk);
 	if (group_dead)
 		disassociate_ctty(1);
 	exit_task_namespaces(tsk);
diff -ru a/kernel/fork.c b/kernel/fork.c
--- a/kernel/fork.c
+++ b/kernel/fork.c
@@ -2362,6 +2362,7 @@
 #endif
 
 	p->pagefault_disabled = 0;
+	p->fxfs_tls = NULL;
 
 #ifdef CONFIG_LOCKDEP
 	lockdep_init_task(p);
