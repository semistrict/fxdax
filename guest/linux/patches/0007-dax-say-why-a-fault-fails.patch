dax: say why a fault fails

A DAX fault that fails returns VM_FAULT_SIGBUS, which says nothing of
why: the filesystem's iomap may have succeeded, and the fault then
failed accessing the device, copying around a shared page, or
inserting the page, which a page's DAX entry naming another page makes
fail (validate_page_before_insert). Each says so, rate-limited, with
the pages involved (fxdax TASK-124).

diff --git a/fs/dax.c b/fs/dax.c
--- a/fs/dax.c
+++ b/fs/dax.c
@@ -1850,15 +1850,23 @@ static vm_fault_t dax_fault_iter(struct vm_fault *vmf,
 	}
 
 	err = dax_iomap_direct_access(iomap, pos, size, &kaddr, &pfn);
-	if (err)
+	if (err) {
+		if (!pmd)
+			pr_err_ratelimited("dax: a fault at index %lx: direct access to %llx failed: %d\n",
+					   xas->xa_index, iomap->addr, err);
 		return pmd ? VM_FAULT_FALLBACK : dax_fault_return(err);
+	}
 
 	*entry = dax_insert_entry(xas, vmf, iter, *entry, pfn, entry_flags);
 
 	if (write && iomap->flags & IOMAP_F_SHARED) {
 		err = dax_iomap_copy_around(pos, size, size, srcmap, kaddr);
-		if (err)
+		if (err) {
+			pr_err_ratelimited("dax: a write fault at index %lx: copying around from %llx (type %u, flags %x) failed: %d\n",
+					   xas->xa_index, srcmap->addr, srcmap->type,
+					   srcmap->flags, err);
 			return dax_fault_return(err);
+		}
 	}
 
 	folio = dax_to_folio(*entry);
@@ -1870,6 +1878,12 @@ static vm_fault_t dax_fault_iter(struct vm_fault *vmf,
 		ret = vmf_insert_folio_pmd(vmf, pfn_folio(pfn), write);
 	else
 		ret = vmf_insert_page_mkwrite(vmf, pfn_to_page(pfn), write);
+	if (!pmd && (ret & VM_FAULT_SIGBUS))
+		pr_err_ratelimited("dax: a %s fault at index %lx: inserting pfn %lx (refs %d), iomap %llx flags %x, failed: its entry's pfn %lx%s\n",
+				   write ? "write" : "read", xas->xa_index, pfn,
+				   folio_ref_count(pfn_folio(pfn)), iomap->addr, iomap->flags,
+				   dax_to_pfn(*entry),
+				   dax_is_zero_entry(*entry) ? ", the zero page" : "");
 	folio_put(folio);
 
 	return ret;
@@ -1897,6 +1911,8 @@ static vm_fault_t dax_iomap_pte_fault(struct vm_fault *vmf, unsigned long *pfnp,
 	 * a reliable test.
 	 */
 	if (iter.pos >= i_size_read(iter.inode)) {
+		pr_err_ratelimited("dax: a fault at %llx, past the file's end at %llx\n", iter.pos,
+				   i_size_read(iter.inode));
 		ret = VM_FAULT_SIGBUS;
 		goto out;
 	}
