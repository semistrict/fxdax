sched: a slot in each task for the thread-local values of Fxfs's Rust

fs/fxfs's Rust keeps thread-local values (its executor's, and std's), in
a slot of the task, which a new task starts without, and which are
dropped as the task exits (fs/fxfs/rt.c, include/linux/fxfs_tls.h, which
this adds too).

diff --git a/include/linux/sched.h b/include/linux/sched.h
--- a/include/linux/sched.h
+++ b/include/linux/sched.h
@@ -1280,6 +1280,9 @@ struct task_struct {
 	/* Journalling filesystem info: */
 	void				*journal_info;
 
+	/* fxdax: the thread-local values of fs/fxfs's Rust (fs/fxfs/rt.c). */
+	void				*fxfs_tls;
+
 	/* Stacked block device info: */
 	struct bio_list			*bio_list;
 
diff --git a/kernel/exit.c b/kernel/exit.c
--- a/kernel/exit.c
+++ b/kernel/exit.c
@@ -79,6 +79,8 @@
 
 #include "exit.h"
 
+#include <linux/fxfs_tls.h>
+
 /*
  * The default value should be high enough to not crash a system that randomly
  * crashes its kernel from time to time, but low enough to at least not permit
@@ -976,6 +978,7 @@ void __noreturn do_exit(long code)
 	exit_shm(tsk);
 	exit_files(tsk);
 	exit_fs(tsk);
+	fxfs_rt_tls_exit(tsk);
 	if (group_dead)
 		disassociate_ctty(1);
 	exit_nsproxy_namespaces(tsk);
diff --git a/kernel/fork.c b/kernel/fork.c
--- a/kernel/fork.c
+++ b/kernel/fork.c
@@ -2139,6 +2139,7 @@ __latent_entropy struct task_struct *copy_process(
 #endif
 
 	p->pagefault_disabled = 0;
+	p->fxfs_tls = NULL;
 
 	lockdep_init_task(p);
 
