config FXFS_FS
	bool "Fxfs"
	depends on VIRTIO_EXTENT=y
	select MAPPING_DIRTY_HELPERS if FS_DAX
	select GENERIC_ALLOCATOR if FS_DAX
	help
	  Fuchsia's Fxfs, running in the guest kernels of fxdax's virtual machines,
	  on the virtio extent-store device.
	  Its Rust is built outside Kbuild, by fxdax's scripts/build-guest-kernel.sh,
	  which leaves the archive at fs/fxfs/libfxfs_linux.a.
