# fxdax's options, over Firecracker's configuration (scripts/build-guest-kernel.sh concatenates
# them, the later overriding the earlier): BSD-3-Clause, as fxdax is.
#
# Fxfs, and the extent-store device's driver it stores its filesystem through.
CONFIG_VIRTIO_EXTENT=y
CONFIG_FXFS_FS=y
# Every device on virtio-PCI (Firecracker's --enable-pci, TASK-273): no virtio-MMIO driver, so a
# device left on MMIO is not found, rather than run there.
# CONFIG_VIRTIO_MMIO is not set
# virtio-pmem, for the benchmark's ext4 with DAX on writable pmem, which the guest's Fxfs compares
# with.
CONFIG_VIRTIO_PMEM=y
# sysrq, through /proc/sysrq-trigger only, whose blocked tasks' stacks (w) the bench's watchdog
# dumps when a workload hangs.
CONFIG_MAGIC_SYSRQ=y
CONFIG_MAGIC_SYSRQ_DEFAULT_ENABLE=0x0
# A console on Firecracker's serial port, an 8250 UART (on arm64, one the device tree describes).
CONFIG_SERIAL_8250=y
CONFIG_SERIAL_8250_CONSOLE=y
CONFIG_SERIAL_OF_PLATFORM=y
# xfstests generic/798.
CONFIG_CACHESTAT_SYSCALL=y
# Tracepoints, fs/fxfs's among them (fxfs_trace.h, TASK-44.16), in tracefs, for perf and bpftrace
# (docs/guest-tracepoints.md): event tracing alone, no function tracer, which would patch every
# function's entry at boot.
CONFIG_FTRACE=y
CONFIG_ENABLE_DEFAULT_TRACERS=y
# BPF programs on tracepoints (bpftrace), through uprobe events, which bring event tracing.
CONFIG_BPF_EVENTS=y
# CONFIG_FUNCTION_TRACER is not set
# An oops panics the kernel, and a panic resets the VM at once, so that it ends (TASK-311). A task
# that oopses dies holding what it held: a spinlock taken with interrupts off, which another CPU
# then spins on, deaf to the TLB flushes' IPIs every other CPU waits on, soft lockups on all of
# them for minutes, till the oops had scrolled out of the host's tail of the console. Panicked, the
# guest stops writing, a crash that doc-12's contract covers (what was synced is kept), and the
# oops is the console's last report. Firecracker's own guests run on after an oops, and halt on a
# panic with a vCPU looping in it (PANIC_TIMEOUT=0); a command line's oops= and panic= still say
# otherwise.
CONFIG_PANIC_ON_OOPS=y
CONFIG_PANIC_TIMEOUT=-1
