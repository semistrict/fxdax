#
# A candidate fix, not a mutant (found by this simulator, tests/pmd_over_stale_index and
# tests/interleave's PMD cycles): dax_folio_put leaves an order 0 folio's index, which is its share
# count. dax_associate_entry then takes a page that had an entry at a nonzero index for shared, and
# skips dax_folio_init: a PMD entry of an order 0 folio (its WARN, fs/dax.c:458), and a PMD mapped
# over it. dax.c says a fault's pages are shared if a slice or a move has them in a region, or a page
# of them is relocated. A fix in dax.c would have those faults fall back to PTEs, and so has to keep
# fxfs_dax_cow from forgetting pages that nothing replaces: the fault that falls back never does.

--- a/fs/dax.c
+++ b/fs/dax.c
@@ -390,6 +390,7 @@
 		return ref;
 
 	folio->mapping = NULL;
+	folio->share = 0;
 	order = folio_order(folio);
 	if (!order)
 		return 0;
