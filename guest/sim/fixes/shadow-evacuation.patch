#
# A candidate fix of a diagnostic, not of the window (tests/interleave -s, 49 of 900 seeds at 1,000
# operations, all from fxfs_dax_evacuee_map): fxfs.dax_shadow takes a read-only MAP over a page
# mapped writably since the last seal for a store the host would refuse. An evacuation maps such
# pages when a page was writable in its range's own space and a move took it to a region: nothing
# stores there, as the move zapped its PTEs and no iomap uses the range while the file's semaphore
# keeps the evacuation's place. kernel/device.c's check of writable PTEs, which is what the
# diagnostic stands in for, stays quiet over those seeds. The evacuation's pages are nobody's until
# its MAP: the shadow forgets them.

--- a/guest/linux/fs/fxfs/dax.c
+++ b/guest/linux/fs/fxfs/dax.c
@@ -4262,6 +4262,9 @@
 
 	lockdep_assert_held_write(&file->sem);
 	if (ev->count) {
+		for (r = 0; r < ev->count; r++)
+			fxfs_dax_shadow_map(dax, ev->maps[r].window_offset, ev->maps[r].len, false,
+					    false, 0, 0);
 		fxfs_dax_pause_file(FXFS_DAX_STEP_GATHERED, file->ino);
 		fxfs_dax_delay();
 		began = ktime_get_ns();
