# TASK-44.21, 8af34848c: a sealed piece of a region a seal has yet to reach is mapped from the range's
# own space: reaching for it would map writably across the seal (xfstests generic/013).

--- a/guest/linux/fs/fxfs/dax.c
+++ b/guest/linux/fs/fxfs/dax.c
@@ -2166,7 +2166,7 @@
 	from = region->mapped;
 	if (end <= from)
 		goto out;
-	if (end > region->pages || (sealed && writable)) {
+	if (end > region->pages) {
 		err = -EXDEV;
 		goto out;
 	}
