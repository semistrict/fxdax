# TASK-124, 6dc22efde: pages going unmapped, holes, are relocated: their next mapping elsewhere found
# them unmapped and relocated them not, and a fault's entry refused them: SIGBUS.

--- a/guest/linux/fs/fxfs/dax.c
+++ b/guest/linux/fs/fxfs/dax.c
@@ -1334,7 +1334,6 @@
 static void fxfs_dax_unmap_pages(struct fxfs_dax_range *range, unsigned long page,
 				 unsigned long pages)
 {
-	fxfs_dax_place(range, page, pages, NULL, 0, true);
 	fxfs_dax_clear_writable(range, page, pages);
 	bitmap_clear(range->mapped, page, pages);
 }
