#
# TASK-153.1: a fault with no limit on how many times it has its range dropped, as dax.c had: with
# TASK-140's bug it goes round for ever, unkillable. mutants.sh -b mutants/task-140-read-only-slice.patch
# task-153.1-fault-limit says livelock; TASK-140's bug alone, a fault that fails and says so.

--- a/guest/linux/fs/fxfs/dax.c
+++ b/guest/linux/fs/fxfs/dax.c
@@ -3012,8 +3012,6 @@
 			 * A slice can't take the store: it maps the chunk no more. fxdax: a fault that
 			 * can't get on fails, and says so, as a write does (TASK-140).
 			 */
-			if (++drops > FXFS_DAX_MAX_DROPS)
-				break;
 			ret = fxfs_dax_fault_drop_slice(vmf, ret);
 			if (ret)
 				break;
