+++ b/guest/linux/fs/fxfs/dax.c
@@ -2819,8 +2819,7 @@
 {
 	loff_t last = min(round_down(end, PAGE_SIZE), round_up(i_size_read(inode), PAGE_SIZE));
 
-	return !(flags & (IOMAP_FAULT | IOMAP_ZERO)) && round_up(pos, PAGE_SIZE) < last &&
