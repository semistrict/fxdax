#
# TASK-150.8, TASK-153.5: a write(2)'s move commits before its bytes, a whole page keeping nothing:
# a copy stopping short, reading the moved pages, or a failure before it, loses what they held.

--- a/guest/linux/fs/fxfs/dax.c
+++ b/guest/linux/fs/fxfs/dax.c
@@ -3078,7 +3078,7 @@
 		/* A fault's pages hold what they held: a store may change any part of them. */
 		began = ktime_get_ns();
 		count = fxfs_dax_reserve_write(inode, pos, end, reserved, size, fault, held,
-					     extents, capacity, timed ? &pending : NULL);
+					     extents, capacity, NULL);
 		if (timed)
 			atomic64_add(ktime_get_ns() - began, &dax->write_fxfs_ns);
 		fxfs_dax_delay();
