# TASK-79.28, 97e9fa8ee: a write whose range a fault mapped again too small drops it and maps it
# again. It was a WARN and EIO.

--- a/guest/linux/fs/fxfs/dax.c
+++ b/guest/linux/fs/fxfs/dax.c
@@ -3173,10 +3173,10 @@
 	 * as a slice the write can't use is, and mapped again as large as it needs (-EXDEV). It was
 	 * a WARN and EIO (TASK-79.28).
 	 */
-	if (end <= pos) {
+	if (WARN_ON_ONCE(end <= pos)) {
 		kvfree(extents);
 		fxfs_dax_put_range(dax, range);
-		return -EXDEV;
+		return -EIO;
 	}
 	if (size)
 		size = end;
