#
# TASK-153.3, on 106b6128d's write through a region: a fault that finished between the move's unmap
# and the copy keeps its PTE of the page where its blocks were, which lags under it: a stale read,
# seed 7289 at 200 operations. Since TASK-153.5, a move waits for faults past their iomaps before
# the PTEs go, where a write looked at `users` and unmapped them again.

--- a/guest/linux/fs/fxfs/dax.c
+++ b/guest/linux/fs/fxfs/dax.c
@@ -3107,7 +3107,6 @@
 		 * the file's semaphore held: they wait for nothing it holds. Not for every use of the
 		 * range: an iomap waiting for the semaphore holds one (guest/sim, a deadlock).
 		 */
-		wait_var_event(&range->faulting, !atomic_read(&range->faulting));
 		unmap_mapping_pages(inode->i_mapping, (start >> PAGE_SHIFT) + first, pages, false);
 		/* As in fxfs_dax_map_chunk: unless a seal was in progress, or began since. */
 		seals = fxfs_device_seals(dax->dev);
