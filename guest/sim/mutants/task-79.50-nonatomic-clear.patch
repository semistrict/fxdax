# TASK-79.50, 075723b80: a range's writable bits are cleared a bit at a time, atomically, outside the
# gate: a word written back whole could set again bits the sealer had just cleared.

--- a/guest/linux/fs/fxfs/dax.c
+++ b/guest/linux/fs/fxfs/dax.c
@@ -1318,10 +1318,7 @@
 static void fxfs_dax_clear_writable(struct fxfs_dax_range *range, unsigned long page,
 				    unsigned long pages)
 {
-	unsigned long i;
-
-	for (i = page; i < page + pages; i++)
-		clear_bit(i, range->writable);
+	bitmap_clear(range->writable, page, pages);
 }
 
