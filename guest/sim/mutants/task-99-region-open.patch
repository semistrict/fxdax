# TASK-99, 79f199dcb: a region opens only once no read-only MAP of it is in flight. Without the
# region's lock, a reader's read-only MAP lands after a writer took the pages for writable.

--- a/guest/linux/fs/fxfs/dax.c
+++ b/guest/linux/fs/fxfs/dax.c
@@ -2105,14 +2105,12 @@
 {
 	fxfs_device_assert_in_gate(dax->dev);
 	fxfs_dax_delay();
-	mutex_lock(&region->lock);
 	spin_lock(&dax->regions_lock);
 	if (!region->writable && !region->mapped) {
 		region->writable = true;
 		list_add_tail(&region->writable_list, &dax->writable_regions);
 	}
 	spin_unlock(&dax->regions_lock);
-	mutex_unlock(&region->lock);
 }
 
