# TASK-99, 79f199dcb: a read-only MAP of a region in flight as a writer opens it. The look at `mapped`
# with no region lock, which had that happen, goes back with what let a reader and a writer meet on
# an extent: Fxfs's device write reads as opening it (task-153.3-reopens).

--- a/guest/linux/fs/fxfs/dax.c
+++ b/guest/linux/fs/fxfs/dax.c
@@ -2152,10 +2152,7 @@
 	fxfs_device_assert_in_gate(dax->dev);
 	fxfs_dax_delay();
 	spin_lock(&dax->regions_lock);
-	if (!region->writable) {
-		WARN_ONCE(READ_ONCE(region->mapped),
-			  "fxfs: extent %llx:%llu open, its region mapped read-only\n",
-			  region->branch, region->sequence);
+	if (!region->writable && !region->mapped) {
 		region->writable = true;
 		list_add_tail(&region->writable_list, &dax->writable_regions);
 	}
--- a/guest/sim/fxfs/fxfs.c
+++ b/guest/sim/fxfs/fxfs.c
@@ -451,7 +451,12 @@
 			host_store_write(sim_device_store_offset(moved[page].sequence) +
 					 (moved[page].page << PAGE_SHIFT), data, PAGE_SIZE);
 			sim_device_wrote(moved[page].sequence, moved[page].page, 1);
-			sim_point("a Fxfs write's reply");
+			extent = find_extent(fs, moved[page].sequence);
+			if (extent->open || sim_random() % 2)
+				sim_point("a Fxfs write's reply");
+			else
+				msleep(1);
+			extent->open = true;
 		}
 		up_read(&fs->writes);
 		if (err)
