#
# TASK-79.28 as it was before TASK-147: task-79.28-range-too-small's WARN and EIO, with what has
# kept a fault from mapping a range too small since. On its own that mutant is equivalent: a fault
# that sizes its range from the old end holds the invalidate lock the write's fxfs_dax_fit waits
# for, and one after it sees `growing`. This one says whether the sim reaches what it was.

--- a/guest/linux/fs/fxfs/dax.c
+++ b/guest/linux/fs/fxfs/dax.c
@@ -2912,10 +2912,10 @@
 	 * as a slice the write can't use is, and mapped again as large as it needs (-EXDEV). It was
 	 * a WARN and EIO (TASK-79.28).
 	 */
-	if (end <= pos) {
+	if (WARN_ON_ONCE(end <= pos)) {
 		kvfree(extents);
 		fxfs_dax_put_range(dax, range);
-		return -EXDEV;
+		return -EIO;
 	}
 	if (size)
 		size = end;
@@ -3491,7 +3491,6 @@
 		file->append_bytes = 0;
 	/* The ranges the file's end moves into, mapped as large as they need. */
 	if (iocb->ki_pos + iov_iter_count(from) > old_size) {
-		WRITE_ONCE(file->growing, iocb->ki_pos + iov_iter_count(from));
 		filemap_invalidate_lock(inode->i_mapping);
 		ret = fxfs_dax_fit(inode, iocb->ki_pos + iov_iter_count(from));
 		if (!ret && iocb->ki_pos > old_size)
