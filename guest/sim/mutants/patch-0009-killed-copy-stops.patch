# Patch 0009: a fatal signal stops a write's copy from kernel memory, once its blocks moved.

--- a/fs/dax.c
+++ b/fs/dax.c
@@ -1697,7 +1697,7 @@
 		 * A copy from kernel memory waits for nothing, and may be what a
 		 * filesystem's copy-on-write gave up the old blocks for.
 		 */
-		if (!iov_iter_is_kvec(iter) && fatal_signal_pending(current)) {
+		if (fatal_signal_pending(current)) {
 			ret = -EINTR;
 			break;
 		}
