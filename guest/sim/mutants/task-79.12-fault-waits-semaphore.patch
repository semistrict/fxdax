# TASK-79.12, 718788ca9: faults never wait on a file's semaphore, holding their DAX entry, which a
# write(2) in the gate may wait for, while the semaphore's holder waits for a seal that waits for it.

--- a/guest/linux/fs/fxfs/dax.c
+++ b/guest/linux/fs/fxfs/dax.c
@@ -1561,21 +1561,15 @@
  */
 static int fxfs_dax_down_read(struct fxfs_dax_file *file, bool fault)
 {
-	if (!fault) {
-		down_read(&file->sem);
-		return 0;
-	}
-	return down_read_trylock(&file->sem) ? 0 : -EDEADLK;
+	down_read(&file->sem);
+	return 0;
 }
 
 /* fxdax: as fxfs_dax_down_read, for writing. */
 static int fxfs_dax_down_write(struct fxfs_dax_file *file, bool fault)
 {
-	if (!fault) {
-		down_write(&file->sem);
-		return 0;
-	}
-	return down_write_trylock(&file->sem) ? 0 : -EDEADLK;
+	down_write(&file->sem);
+	return 0;
 }
 
