# TASK-150.14: a slice sets the bits of a write's pieces as it goes, and lists the file after them:
# a piece refused left bits of a file not listed, which a seal then misses.

--- a/guest/linux/fs/fxfs/dax.c
+++ b/guest/linux/fs/fxfs/dax.c
@@ -965,6 +965,7 @@
 	u64 base = range->window_offset - region->window_offset;
 	ssize_t i;
 	int err;
+	bool writable = false;
 
 	fxfs_device_assert_in_gate(dax->dev);
 	lockdep_assert_held_write(&range->file->sem);
@@ -983,8 +984,11 @@
 		err = fxfs_dax_reach(dax, region, end >> PAGE_SHIFT);
 		if (err)
 			return err;
-		fxfs_dax_set_writable(dax, range, page, pages);
+		bitmap_set(range->writable, page, pages);
+		writable = true;
 	}
+	if (writable)
+		fxfs_dax_set_writable(dax, range, 0, 0);
 	return 0;
 }
 
