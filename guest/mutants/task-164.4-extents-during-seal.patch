# Kernel: sim
# Killer: scenarios cow_map_during_seal
#
# TASK-164.4, doc-13: copying on write, a range maps the extents Fxfs says sealed as a seal in
# progress has yet to seal them on the device (OpenExtents::seal, at its beginning): the host
# refuses the MAP (-EPERM), and the range seals and tries again. cow_map_during_seal's write.

--- a/guest/linux/fs/fxfs/dax.c
+++ b/guest/linux/fs/fxfs/dax.c
@@ -1527,7 +1527,7 @@
 	for (;;) {
 		seals = fxfs_device_seals(dax->dev);
 		count = fxfs_nofs(fxfs_dax_extents(fs, ino, offset, len, found, capacity));
-		if (count < 0 || (!(seals & 1) && fxfs_device_seals(dax->dev) == seals))
+		if (count < 0 || true)
 			return count;
 		fxfs_device_wait_unsealed(dax->dev);
 	}
