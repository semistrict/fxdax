# TASK-147: how far a write past the end grows the file, which ranges mapped
# meanwhile are to reach: a fault on the write's own source mapped the chunk only as large as the
# file, and the write's end was lost (xfstests generic/638).

--- a/guest/linux/fs/fxfs/dax.c
+++ b/guest/linux/fs/fxfs/dax.c
@@ -2843,7 +2843,6 @@
 	end = iocb->ki_pos + iov_iter_count(from);
 	/* The ranges the file's end moves into, mapped as large as they need. */
 	if (end > old_size) {
-		WRITE_ONCE(file->growing, end);
 		filemap_invalidate_lock(inode->i_mapping);
 		ret = fxfs_dax_fit(inode, end);
 		if (!ret && iocb->ki_pos > old_size)
