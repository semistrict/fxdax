# Kernel: sim
# Killer: scenarios cow_store_to_pinned_slice
#
# TASK-79.49: a store from user mode fails on a page of a slice pinned, as a fault from the kernel
# does: a SIGBUS where the pin goes soon. Killed by slice_held (GCE r307), a vmsplice pinning a
# slice's page and a store to it, which went with writable DAX (37c331a6c); fxfs-guest-checks-dax
# passed with it in, 3 rounds (GCE fxdax-test-r625, 2026-11-05). Not equivalent copying on write: a
# store to a slice's chunk still drops the slice (-EXDEV), which waits for its pages to be unused.
# guest/sim pins a page as get_user_pages does since (sim_pin_user_page, TASK-149.31):
# cow_store_to_pinned_slice, slice_held's steps, fails with "a store to page 0", its fault failing
# with the slice's -EXDEV as the drop refuses to wait for the pin.

--- a/guest/linux/fs/fxfs/dax.c
+++ b/guest/linux/fs/fxfs/dax.c
@@ -1717,7 +1717,7 @@
  */
 static vm_fault_t fxfs_dax_fault_drop_slice(struct vm_fault *vmf, vm_fault_t ret)
 {
-	bool user = vmf->flags & FAULT_FLAG_USER;
+	bool user = false;
 	int err = fxfs_dax_drop_slice(file_inode(vmf->vma->vm_file),
 				      (loff_t)vmf->pgoff << PAGE_SHIFT, user);
 
