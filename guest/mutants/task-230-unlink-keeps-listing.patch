# Kernel: release
# Killer: fxfs-guest-checks listings_follow_changes
#
# TASK-230: an unlink keeps its directory's listing (fxfs_vfs_dir_listing): fxfs_vfs_unlink, which
# a file's unlink and rmdir go through, drops none, so a read after it finds the name removed.
# listings_follow_changes removes listed/a and reads "listed": a still there. super.c, which
# guest/sim doesn't build. Put in by hand, not a past bug: one of the four kinds of change whose
# drop is a code path of its own (create, unlink, rename, exchange).

--- a/guest/linux/fs/fxfs/super.c
+++ b/guest/linux/fs/fxfs/super.c
@@ -805,7 +805,6 @@ static int fxfs_vfs_unlink(struct inode *dir, struct dentry *dentry)
 	struct fxfs_attr dir_attr;
 	int replaced;
 
-	fxfs_vfs_dir_changes(dir);
 	if (!S_ISDIR(inode->i_mode)) {
 		int err = fxfs_nofs(fxfs_unlink_later(fs, dir->i_ino, dentry->d_name.name,
 						      dentry->d_name.len, inode->i_ino));
