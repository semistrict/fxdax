# Kernel: sim
# Killer: none
#
# TASK-150.9: a DAX file's change of size has Fxfs zero its last block past the end by moving it
# (FXFS_SET_KEEP_TAIL dropped), from under the window, which goes on mapping it. Killed by neither
# the simulator nor a real kernel since copying on write: fxfs-guest-checks-dax's
# append_stopped_short_in_a_page killed it before (GCE fxdax-test-t18-ac, 2026-11-03), and passes
# with it in now, alone in 3 rounds (GCE fxdax-test-r625, 2026-11-05) and among the suite's every
# check; guest/sim's model of Fxfs moves the block so too (zero_tail), and none of its one-run tests
# or scenarios, nor 300 seeds of interleave and failures, fails with it in. A blind spot, not an
# equivalent: TASK-149.30, which is to have the simulator kill it.

--- a/guest/linux/fs/fxfs/data.c
+++ b/guest/linux/fs/fxfs/data.c
@@ -40,7 +40,7 @@
 	truncate_setsize(inode, size);
 	if (iattr)
 		setattr_copy(idmap, inode, iattr);
-	err = fxfs_vfs_write_attr(inode, FXFS_SET_SIZE | (ops->keeps_tail ? FXFS_SET_KEEP_TAIL : 0));
+	err = fxfs_vfs_write_attr(inode, FXFS_SET_SIZE);
 	/*
 	 * fxdax: with no room, a file grown goes back to its size: nothing is past its old end yet,
 	 * and the inode saying a size Fxfs hasn't would lose it at eviction. A cut borrows the room
