#
# Kernel: sim
# Killer: scenarios cow_writeback_during_fault
#
# TASK-164.4, doc-13: writeback's write-protect left to dax_writeback_mapping_range, by the DAX
# entries, as it was: a fault past its iomap_end holds its page's entry, which dax_writeback_one,
# finding it locked, gives up on, and the fault's writable PTE stays. cow_writeback_during_fault:
# the rebind's read-only MAP under it, refused; interleave's seed 22, 15 of CI's 3,000. Since
# TASK-164.9 writeback reads nothing of the entries: this puts their cleaning (as writepages and
# fxfs_dax_release clean them, for the kernel's sake) in place of the page tables' write-protect.
# In a release guest kernel, fxfs-guest-fsx-dax, -fsx-delay-dax and -checks-dax pass with it (GCE
# r1000, TASK-149.2), and -script-dax, its files then the page cache's: no VM's stores met a
# writeback's locked entry as the simulator's scenario has them.

--- a/guest/linux/fs/fxfs/dax.c
+++ b/guest/linux/fs/fxfs/dax.c
@@ -2226,7 +2226,7 @@
 	}
 	fxfs_dax_count(dax, file, 0, -pages);
 	up_write(&file->sem);
-	fxfs_dax_protect(inode->i_mapping, batch, nr);
+	fxfs_dax_clean_entries(inode, 0, LLONG_MAX);
 	/* Before it reads its ranges' window pages, which nothing may free (pause points). */
 	fxfs_dax_pause_file(FXFS_DAX_STEP_WRITEBACK, inode->i_ino);
 	err = fxfs_dax_write_pages(dax, inode, batch, nr, parts, run_parts, &kept);
