# Kernel: sim
# Killer: scenarios cow_rebind_during_writeback
#
# TASK-164.4, doc-13: writeback holds no wb_lock from its swap to its commit: a rebind finds the
# pages it swapped out clean, their extents Fxfs's old ones, and maps those over the private pages
# it is writing. cow_rebind_during_writeback.

--- a/guest/linux/fs/fxfs/dax.c
+++ b/guest/linux/fs/fxfs/dax.c
@@ -2176,7 +2176,6 @@
 	 * them, and an fsync returns only once they are durable. Returning at once, as no page was
 	 * dirty, an fsync met by the worker's writeback sealed none of its pages (guest/sim, seed 962).
 	 */
-	mutex_lock(&file->wb_lock);
 	if (!atomic_long_read(&file->dirty_pages))
 		goto out;
 	parts = kmalloc_array(FXFS_DAX_WRITEBACK_RUN, sizeof(*parts), GFP_NOFS);
@@ -2250,7 +2249,6 @@
 	if (kept)
 		err = err ?: -ENOMEM;
 out:
-	mutex_unlock(&file->wb_lock);
 	kfree(run_parts);
 	kfree(parts);
 	kvfree(batch);
