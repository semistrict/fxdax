# Kernel: release
# Killer: none
#
# TASK-79.49: a fault with no room looks for none of its signals: a splice holding the window
# couldn't be killed, window_held_killed's process still running (GCE r307). Equivalent since a
# fault's waits for room are bounded (FXFS_DAX_NO_ROOM_WAITS) and killable (fxfs_dax_wait_released's
# wait_event_killable_timeout): killed, each wait returns at once, and the fault fails after its
# 3,000 rounds, its process dying all the same. fxfs-guest-checks-dax-small passes with it in,
# window_held_killed alone in 3 rounds and every check of it once (GCE fxdax-test-r625, 2026-11-05),
# as the DAX gate's suites did at 10e0d6749.

--- a/guest/linux/fs/fxfs/dax.c
+++ b/guest/linux/fs/fxfs/dax.c
@@ -2992,10 +2992,6 @@
 		if (error != -EAGAIN && error != -EXDEV)
 			break;
 		/* fxdax: a fault killed meanwhile tries no more (TASK-79.49). */
-		if (fatal_signal_pending(current)) {
-			ret = VM_FAULT_SIGBUS;
-			break;
-		}
 		if (error == -EXDEV) {
 			/*
 			 * A slice can't take the store: it maps the chunk no more. fxdax: a fault that
