# Kernel: release
# Killer: fxfs-guest-fsx-dax
#
# TASK-149.16, TASK-133: a DAX write that stops short, its source faulting partway, leaves Fxfs's
# size where the write was to end, which its iomap grew it to, the inode's being what it wrote: the
# file read in again is longer, zeros past what was written. fxfs-guest-fsx-dax's writes from
# buffers that fault, in the hostile mix, appends among them; the guest shrinks what fails.

--- a/guest/linux/fs/fxfs/dax.c
+++ b/guest/linux/fs/fxfs/dax.c
@@ -3370,11 +3370,6 @@
 	 * A write that stopped short leaves the file no longer than it wrote: one that wrote nothing
 	 * leaves it as it was, wherever it began past the end.
 	 */
-	if (iocb->ki_pos < end && end > old_size) {
-		err = fxfs_data_resize(inode, done ? max(old_size, iocb->ki_pos) : old_size, NULL, NULL);
-		if (err && !done)
-			ret = err;
-	}
 	if (done)
 		ret = done;
 	fxfs_dax_lap(&dax->write_tail_ns, &lap);
