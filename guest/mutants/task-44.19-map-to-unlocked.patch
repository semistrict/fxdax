#
# Kernel: sim
# Killer: none
#
# TASK-44.19: a region's MAPs and its `mapped` without the region's lock. Two readers of slices of
# one staging extent each MAP from what they found mapped, and the one that ends last says how far.
# Killed by neither the simulator nor a real kernel: no guest suite found it (GCE, 2026-11-02, as
# scripts/guest-mutants-gce.py's map_to_unlocked), nor 3,000 seeds here; reaches_at_once, which
# wrote through slices, did, and went with writable DAX. Copying on write, only reads take slices,
# and each range MAPs every page it uses: what is left is the region's put UNMAPping less than the
# host maps, which no oracle here or in the guest's suites checks.

--- a/guest/linux/fs/fxfs/dax.c
+++ b/guest/linux/fs/fxfs/dax.c
@@ -1397,7 +1397,6 @@
 	unsigned long from, to;
 	int err = 0;
 
-	mutex_lock(&region->lock);
 	from = region->mapped;
 	if (end <= from)
 		goto out;
@@ -1432,7 +1431,6 @@
 			from, to, region->branch, region->sequence, region->pages,
 			region->window_offset, err);
 out:
-	mutex_unlock(&region->lock);
 	return err;
 }
 
