# Kernel: sim
# Killer: scenarios cow_private_failed
#
# TASK-164.9, doc-13: the iomap whose PRIVATE fails goes on, its pages dirty, as a write(2)'s
# PRIVATE ahead of its copy did before: dirty without private, the store left to the host's copy,
# after a writeback may have moved the page's block. cow_private_failed: the write succeeds, and the
# store reaches a page no PRIVATE made the VM's.

--- a/guest/linux/fs/fxfs/dax.c
+++ b/guest/linux/fs/fxfs/dax.c
@@ -2684,15 +2684,7 @@
 		if (err) {
 			pr_warn_ratelimited("fxfs: making %lu pages at %llx of the window private: %d\n",
 					    pages + ahead, fxfs_dax_page_offset(range, first), err);
-			atomic_long_sub(newly + beyond, &dax->private);
-			wake_up_all(&dax->budget_wait);
-			/*
-			 * fxdax: ENOMEM as ENOMEM, the guest's request's memory not found, not EIO
-			 * (TASK-44.15); the host's refusal is EIO already (fxfs_device_private).
-			 */
-			if (err != -ENOMEM)
-				err = -EIO;
-			goto unreserve;
+			err = 0;
 		}
 		WRITE_ONCE(range->file->dirtied, jiffies);
 	}
