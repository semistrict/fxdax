# Kernel: sim
# Killer: scenarios cow_reclaim_during_writeback
#
# TASK-164.2, doc-13, GCE r544's class: a writeback holds no range of the pages it reads from the
# window, so reclaim frees one under it, its space given to another range, and the writeback reads
# that range's pages, or nothing mapped, for the file's. cow_reclaim_during_writeback.

--- a/guest/linux/fs/fxfs/dax.c
+++ b/guest/linux/fs/fxfs/dax.c
@@ -2321,7 +2321,7 @@
 	unsigned long kept = 0;
 	struct fxfs_dax_range *range;
 	unsigned long chunk;
-	size_t nr = 0, most, now, i;
+	size_t nr = 0, most, now;
 	long pages = 0, written = 0;
 	bool traced = false;
 	int err = 0;
@@ -2378,8 +2378,6 @@
 		if (!fxfs_dax_range_dirty(range))
 			continue;
 		batch[nr].range = range;
-		/* Kept, mapped, while the writeback reads it: no reclaim, no drop. */
-		atomic_inc(&range->users);
 		pages += fxfs_dax_pages_swap(range->state, batch[nr].pages);
 		bitmap_zero(batch[nr].kept, FXFS_DAX_PAGES);
 		nr++;
@@ -2396,8 +2394,6 @@
 	} else if (kept) {
 		kept = fxfs_dax_keep(inode, batch, nr);
 	}
-	for (i = 0; i < nr; i++)
-		fxfs_dax_put_range(dax, batch[i].range);
 	atomic64_inc(&dax->writebacks);
 	written = pages - kept;
 	atomic64_add(written, &dax->written);
