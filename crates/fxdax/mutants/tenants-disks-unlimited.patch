@@ -169,7 +169,7 @@
         if !take(&USED, TOTAL_LIMIT.load(Ordering::Relaxed)) {
             return Err(self.refuse());
         }
-        if !take(&self.used, self.limit.load(Ordering::Relaxed)) {
+        if !take(&self.used, NONE) {
             USED.fetch_sub(bytes, Ordering::SeqCst);
