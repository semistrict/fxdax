# A VM process keeps as much in flight as it likes, its replies unread: the daemon holds them all,
# rather than let it go past its room (TASK-79.16).
# Kind: memory
# Killer: extentd::tests::hostile::a_compromised_vm_process_harms_no_tenant_beside_it
--- a/crates/fxdax/src/extentd/server.rs
+++ b/crates/fxdax/src/extentd/server.rs
@@ -945,7 +945,7 @@
         let mut requests = self.requests.lock().unwrap();
         let in_flight = requests.in_flight();
         let held = requests.stream_bytes + bytes + self.peer.sender.queued();
-        if in_flight >= MAX_REQUESTS || held > self.peer.room() {
+        if in_flight >= MAX_REQUESTS {
             let what = format!("{} requests, and {held} bytes, in flight", in_flight + 1);
             return Err(std::io::Error::new(std::io::ErrorKind::QuotaExceeded, what));
         }
